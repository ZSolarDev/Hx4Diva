import haxe.Json;
import hxp.Log;
import hxp.Path;
import hxp.Script;
import hxp.System;
import sys.FileSystem;
import sys.io.File;

using StringTools;

class BuildMod extends Script {
	override public function new() {
		try {
			super();
			Utils.flags = flags;
			Utils.workingDirectory = workingDirectory;

			Log.info('', 'Loading mod project file.');
			var data = ModProjectLoader.loadModData(commandArgs[0]);
			var modData:ModData = data.data;
			Log.info('', 'Loaded mod project file. Validating...');
			ModProjectLoader.validateModData(modData);
			// TODO: add hx4diva when this goes into haxelib dev
			modData.dependencies.push('linc_directx');
			modData.dependencies.push('linc_imgui');
			modData.macros.push('addGlobalMetadata("d3d11", "@:headerCode(\'#include <vector>\')", true, true, false)');
			modData.macros.push('addGlobalMetadata("dxgi", "@:headerCode(\'#include <vector>\')", true, true, false)');
			Log.info('', 'Validated mod project file. Generating HXML...');
			var hxml = Builder.generateHxml(modData, data.path);
			Log.info('Building...\n', 'HXML Generated:\n$hxml\n\nBuilding...\n\n');
			var res = Builder.buildModHx(modData, hxml);
			if (res != 0)
				throw 'Failed to build mod with exit code $res. Exiting.';
			Log.info('', 'Build successful. Generating mod structure...');
			Builder.generateFinalModStructure(modData);
			Log.info('', 'Mod structure generated.');
			if (modData.postBuildCommands != null && modData.postBuildCommands.length > 0) {
				Log.info('Running post-build commands...');
				for (command in modData.postBuildCommands)
					System.runCommand('', command);
			}
			var finalModPath = Path.join([Utils.workingDirectory, modData.modOutput]).replace("\\", "/");
			Log.info('\n>>\n>> Mod "${modData.name}" was built successfully${(flags.exists('debug') && flags.get('debug') ? ' in debug mode' : '')}. The resulting mod is located at "$finalModPath".\n>>\n');
		} catch (e) {
			Log.error('FATAL ERROR: ${e.message}', 'FATAL ERROR: ${e.message}\nStack:\n${e.stack.toString()}');
			Sys.exit(1);
		}
	}
}

typedef ModData = {
	var name:String;
	var ?description:String;
	var ?authors:Array<String>;
	var ?version:String;
	var main:String;
	var classPath:String;
	var modOutput:String;
	var ?dependencies:Array<String>;
	var ?macros:Array<String>;
	var ?postBuildCommands:Array<String>;
	var ?append:ModAppendData;
}

typedef ModAppendData = {
	var config:String;
	var hxml:String;
}

class ModProjectLoader {
	public static function loadModData(reqPath:String):{data:ModData, path:String} {
		if (reqPath == null || !FileSystem.exists(reqPath))
			reqPath = 'mod.json';
		reqPath = Path.join([Utils.workingDirectory, reqPath]);

		Log.info('', 'Loading mod project file from "${reqPath}".');
		if (!FileSystem.exists(reqPath))
			throw 'mod.json was not found.';

		return {data: Json.parse(File.getContent(reqPath)), path: reqPath};
	}

	public static function validateModData(data:ModData) {
		if (data == null)
			throw 'Invalid mod project file.';
		if (data.main == null)
			throw 'Mod project requires an entrypoint.';
		if (data.modOutput == null)
			throw 'Mod project requires an output directory.';

		if (!FileSystem.exists(Path.join([Utils.workingDirectory, data.classPath])))
			throw 'Class path "${data.classPath}" does not exist.';

		var exists = false;
		for (ext in ['.hx', '.Hx', '.HX', '.hX'])
			if (FileSystem.exists(Path.join([Utils.workingDirectory, data.classPath, data.main + ext])))
				exists = true;
		if (!exists)
			throw 'Main class "${data.main}" does not exist.';

		if (data.dependencies == null)
			data.dependencies = [];

		if (data.macros == null)
			data.macros = [];

		if (data.append == null)
			return;

		if (data.append.config != null)
			if (!FileSystem.exists(Path.join([Utils.workingDirectory, data.append.config])))
				throw 'Config file append "${data.append.config}" does not exist.';

		if (data.append.hxml != null)
			if (!FileSystem.exists(Path.join([Utils.workingDirectory, data.append.hxml])))
				throw 'HXML file append "${data.append.hxml}" does not exist.';
	}
}

class Builder {
	public static function generateHxml(data:ModData, modDataPath:String):String {
		var hxml:String = '# Generated by Hx4Diva ${File.getContent('_current')}

        -main ${data.main}
        -cp ${data.classPath}
        -cpp ${data.modOutput.toLowerCase() + '_hxOut'}
        --resource $modDataPath@modData
        -dce no
        -D dll_link';

		if (data.macros != null && data.macros.length > 0) {
			hxml += '\n\n# Macros\n';
			for (macroLine in data.macros)
				hxml += '--macro $macroLine\n';
		}

		if (data.dependencies != null && data.dependencies.length > 0) {
			hxml += '\n# Dependencies\n';
			for (dep in data.dependencies)
				hxml += '-lib $dep\n';
		}

		if (Utils.flags.exists('debug') && Utils.flags.get('debug'))
			hxml += '\n# Debug\n--debug';

		hxml = hxml.replace('        ', '');

		if (data.append != null && data.append.hxml != null) {
			hxml += '\n\n# Appended Data\n';
			hxml += File.getContent(Path.join([Utils.workingDirectory, data.append.hxml]));
		}
		return hxml;
	}

	public static function buildModHx(data:ModData, hxml:String):Int {
		File.saveContent(Path.join([Utils.workingDirectory, '_hxOut.hxml']), hxml);
		var res = System.runCommand('', 'haxe _hxOut.hxml');
		Sys.sleep(3);
		if (FileSystem.exists(Path.join([Utils.workingDirectory, '_hxOut.hxml'])))
			FileSystem.deleteFile(Path.join([Utils.workingDirectory, '_hxOut.hxml']));
		return res;
	}

	public static function generateFinalModStructure(data:ModData) {
		var modOutputPath = Path.join([Utils.workingDirectory, data.modOutput]);
		var modOutputPath_hxLibs = Path.join([modOutputPath, 'hxLibs']);
		if (!FileSystem.exists(modOutputPath))
			FileSystem.createDirectory(modOutputPath);
		if (!FileSystem.exists(modOutputPath_hxLibs))
			FileSystem.createDirectory(modOutputPath_hxLibs);

		if (Utils.flags.exists('debug') && Utils.flags.get('debug')) {
			File.copy('runtime/Hx4Diva/x64/Debug/Hx4Diva.dll', Path.join([modOutputPath, 'Hx4Diva.dll']));
			File.copy('runtime/Hx4Diva/x64/Debug/Hx4Diva.pdb', Path.join([modOutputPath, 'Hx4Diva.pdb']));
			File.copy(Path.join([Utils.workingDirectory, data.modOutput + '_hxOut', data.main + '-debug.dll']),
				Path.join([modOutputPath_hxLibs, data.main + '.dll']));
			File.copy(Path.join([
				Utils.workingDirectory,
				data.modOutput + '_hxOut',
				'obj',
				'lib',
				data.main + '-debug.pdb'
			]), Path.join([modOutputPath_hxLibs, data.main + '.pdb']));
		} else {
			File.copy('runtime/Hx4Diva/x64/Release/Hx4Diva.dll', Path.join([modOutputPath, 'Hx4Diva.dll']));
			File.copy(Path.join([Utils.workingDirectory, data.modOutput + '_hxOut', data.main + '.dll']),
				Path.join([modOutputPath_hxLibs, data.main + '.dll']));
			if (FileSystem.exists(Path.join([modOutputPath_hxLibs, data.main + '.pdb'])))
				FileSystem.deleteFile(Path.join([modOutputPath_hxLibs, data.main + '.pdb']));
			if (FileSystem.exists(Path.join([modOutputPath, 'Hx4Diva.pdb'])))
				FileSystem.deleteFile(Path.join([modOutputPath, 'Hx4Diva.pdb']));
		}

		var config = '# Generated by Hx4Diva ${File.getContent('_current')}\n\n';
		config += 'enabled = true\n';
		config += 'include = ["."]\n';
		config += 'dll = ["Hx4Diva.dll"]\n\n';
		config += 'name = "${data.name}"\n';
		if (data.description != null)
			config += 'description = "${data.description}"\n';
		if (data.authors != null)
			config += 'author = "${data.authors.join(', ')}"\n';
		if (data.version != null)
			config += 'version = "${data.version}"\n';
		config += 'date = "${DateTools.format(Date.now(), '%d.%m.%Y')}"\n';
		if (data.append != null && data.append.config != null) {
			config += '\n# Appended data\n\n';
			config += File.getContent(Path.join([Utils.workingDirectory, data.append.config])).replace('\r\n', '\n');
		}
		File.saveContent(Path.join([modOutputPath, 'config.toml']), config);
	}
}

class Utils {
	public static var workingDirectory:String;
	public static var flags = new Map<String, Bool>();

	public static function copyDirectory(source:String, destination:String):Void {
		if (!FileSystem.exists(destination))
			FileSystem.createDirectory(destination);

		for (item in FileSystem.readDirectory(source)) {
			var srcPath = Path.join([source, item]);
			var dstPath = Path.join([destination, item]);

			if (FileSystem.isDirectory(srcPath))
				copyDirectory(srcPath, dstPath);
			else
				File.copy(srcPath, dstPath);
		}
	}
}
